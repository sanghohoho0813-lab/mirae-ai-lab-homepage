   "start": 44.31,
   "end": 46.25
  },
  {
   "block": 2,
   "line": 7,
   "part": 2,
   "text": "누구나 AI로 쓴 비슷비슷한 계획서 중 하나가",
   "start": 46.27,
   "end": 49.04
  },
  {
