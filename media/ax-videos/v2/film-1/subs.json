[
 {
  "in": 0.79,
  "out": 3.99,
  "text": "정책자금도, 투자도,\n정부지원사업도,"
 },
 {
  "in": 4.07,
  "out": 6.35,
  "text": "매번 한 끗 차이로\n놓치고 계신가요?"
 },
 {
  "in": 6.43,
  "out": 9.29,
  "text": "요즘 자금이랑 정부지원사업\n시장, 쉽지 않죠?"
 },
 {
  "in": 9.37,
  "out": 11.01,
  "text": "경쟁이 굉장히 치열합니다."
 },
 {
  "in": 11.09,
  "out": 14.09,
  "text": "게다가 매주 엄청난 기술들이\n쏟아져 나오고 있어서,"
 },
 {
  "in": 14.17,
  "out": 16.23,
  "text": "AI 시대에 우리 회사만\n제자리인 것 같아"
 },
 {
  "in": 16.31,
  "out": 18.45,
  "text": "뒤처질까 불안하기도 하실 겁니다."
 },
 {
  "in": 18.59,
  "out": 19.67,
  "text": "그럼에도 이 세 분야에서"
 },
 {
  "in": 19.75,
  "out": 22.21,
  "text": "좋은 결과를 내는\n회사들은 분명히 있죠."
 },
 {
  "in": 22.41,
  "out": 24.73,
  "text": "이런 회사, 투자자와\n심사위원이 보기에도"
 },
 {
  "in": 24.81,
  "out": 26.71,
  "text": "매력적인 회사로 만들고 싶은 분은"
 },
 {
  "in": 26.79,
  "out": 27.77,
  "text": "끝까지 봐 주세요."
 },
 {
  "in": 28.11,
  "out": 29.51,
  "text": "왜 이렇게 점점\n어려워지는 걸까요?"
 },
 {
  "in": 29.59,
  "out": 32.87,
  "text": "예전에는 계획서만 잘\n써도 통했습니다."
 },
 {
  "in": 32.99,
  "out": 35.83,
  "text": "하지만 지금은 계획서만으로는\n경쟁력이 없어요."
 },
 {
  "in": 35.91,
  "out": 38.01,
  "text": "계획서는 결국 계획일 뿐이니까요."
 },
 {
  "in": 38.09,
  "out": 41.17,
  "text": "브리핑이 끝나면 심사하시는\n분이 꼭 묻습니다."
 },
 {
  "in": 41.29,
  "out": 42.89,
  "text": "“그래서, 다음은\n어떻게 되나요?”"
 },
 {
  "in": 43.03,
  "out": 45.83,
  "text": "여기서 “자금이 들어오면\n하겠습니다”라고 답하면,"
 },
 {
  "in": 45.91,
  "out": 48.11,
  "text": "우리 회사가 제출한 사업계획서는"
 },
 {
  "in": 48.19,
  "out": 50.88,
  "text": "누구나 AI로 쓴 비슷비슷한\n계획서 중 하나가"
 },
 {
  "in": 50.96,
  "out": 52.11,
  "text": "되어 버리고 맙니다."
 },
 {
  "in": 52.21,
  "out": 53.73,
  "text": "계획이 부족한 게 아니에요."
 },
 {
  "in": 53.81,
  "out": 55.11,
  "text": "보여 줄 게 없는 거죠."
 },
 {
  "in": 55.41,
  "out": 56.85,
  "text": "이제는 계획을 넘어서"
 },
 {
  "in": 56.93,
  "out": 59.07,
  "text": "실제로 무언가를 보여\n줘야 되는 시대예요."
 },
 {
  "in": 59.15,
  "out": 61.97,
  "text": "심사하는 쪽이 결국\n보는 건 하나입니다."
 },
 {
  "in": 62.05,
  "out": 64.49,
  "text": "이 회사가 다음 단계로\n커질 수 있는지,"
 },
 {
  "in": 64.57,
  "out": 67.67,
  "text": "그래야 빌려준 돈과 투자한\n돈이 돌아오니까요."
 },
 {
  "in": 67.75,
  "out": 69.85,
  "text": "그럼 보여 줄 화면은\n어디서 나올까요?"
 },
 {
  "in": 69.93,
  "out": 72.09,
  "text": "재료는 이미 회사 안에 있습니다."
 },
 {
  "in": 72.17,
  "out": 74.87,
  "text": "고객, 매출, 재고,\n직원의 기록이"
 },
 {
  "in": 74.95,
  "out": 77.25,
  "text": "엑셀과 메신저, 누군가의 메모장에"
 },
 {
  "in": 77.33,
  "out": 78.69,
  "text": "흩어져 있을 뿐이에요."
 },
 {
  "in": 78.81,
  "out": 81.53,
  "text": "이게 한곳에 쌓이면 회사의\n가장 큰 자산인데,"
 },
 {
  "in": 81.61,
  "out": 84.49,
  "text": "흩어져 있으면 성장했다는\n증거로도 쓸 수 없고,"
 },
 {
  "in": 84.57,
  "out": 86.23,
  "text": "일을 아는 직원 한 명이 나가면"
 },
 {
  "in": 86.31,
  "out": 87.99,
  "text": "회사가 통째로 흔들릴\n수도 있습니다."
 },
 {
  "in": 88.07,
  "out": 90.85,
  "text": "그럼 정책자금이나 투자를\n잘 받는 회사들은"
 },
 {
  "in": 90.93,
  "out": 92.11,
  "text": "뭐가 다를까요?"
 },
 {
  "in": 92.35,
  "out": 95.27,
  "text": "저희는 최근 3년간\n정책자금과 정부 R&D,"
 },
 {
  "in": 95.35,
  "out": 96.77,
  "text": "투자를 받은 회사 사례를"
 },
 {
  "in": 96.85,
  "out": 99.07,
  "text": "250건 가까이 살펴봤습니다."
 },
 {
  "in": 99.15,
  "out": 101.11,
  "text": "거기서 반복되는 흐름이 있었어요."
 },
 {
  "in": 101.19,
  "out": 102.79,
  "text": "고객 데이터를 꾸준히 쌓고,"
 },
 {
  "in": 102.87,
  "out": 105.39,
  "text": "그걸 고객이 직접 쓰는\n플랫폼으로 키우고,"
 },
 {
  "in": 105.47,
  "out": 108.61,
  "text": "회사 안 운영과 하나로\n연결해 뒀다는 겁니다."
 },
 {
  "in": 108.69,
  "out": 109.99,
  "text": "여기서 말하는 플랫폼은"
 },
 {
  "in": 110.07,
  "out": 112.15,
  "text": "쿠팡이나 네이버 같은\n거대한 서비스를"
 },
 {
  "in": 112.23,
  "out": 113.23,
  "text": "말씀드리는 게 아니에요."
 },
 {
  "in": 113.31,
  "out": 115.27,
  "text": "우리 업종에 특화된,"
 },
 {
  "in": 115.35,
  "out": 117.53,
  "text": "고객과 거래처가 모이는\n작은 서비스 정도로"
 },
 {
  "in": 117.61,
  "out": 119.15,
  "text": "생각하시면 됩니다."
 },
 {
  "in": 119.23,
  "out": 120.97,
  "text": "실제로 이런 사례가 있었어요."
 },
 {
  "in": 121.05,
  "out": 122.93,
  "text": "렌털업체가 손으로 쓰던 장부를"
 },
 {
  "in": 123.01,
  "out": 124.65,
  "text": "클라우드 시스템으로 바꾸고,"
 },
 {
  "in": 124.73,
  "out": 125.81,
  "text": "그 데이터를 바탕으로"
 },
 {
  "in": 125.89,
  "out": 128.33,
  "text": "금융 사업까지 넓힐\n논리까지 갖춰서"
 },
 {
  "in": 128.41,
  "out": 131.79,
  "text": "15억 원 규모의 보증과\n금융지원을 받았습니다."
 },
 {
  "in": 131.87,
  "out": 135.67,
  "text": "그 밖에도 히트펌프는\n운영·모니터링 구독 서비스로,"
 },
 {
  "in": 135.75,
  "out": 138.93,
  "text": "수산물 유통은 데이터\n기반 B2B 플랫폼으로,"
 },
 {
  "in": 139.01,
  "out": 142.55,
  "text": "부동산 중개 현장은 공실 관리\n자동화 플랫폼으로 바꾸어"
 },
 {
  "in": 142.63,
  "out": 145.05,
  "text": "성장자금을 받은\n회사들이 있었고요."
 },
 {
  "in": 145.13,
  "out": 148.33,
  "text": "제조, 유통, 숙박까지\n업종은 모두 달랐지만"
 },
 {
  "in": 148.41,
  "out": 150.19,
  "text": "대부분 흐름은 같았습니다."
 },
 {
  "in": 150.27,
  "out": 152.55,
  "text": "데이터가 쌓이고 사람이\n모이는 구조가,"
 },
 {
  "in": 152.63,
  "out": 154.69,
  "text": "회사가 더 커질 수 있다는\n걸 보여 줬다는 점이"
 },
 {
  "in": 154.77,
  "out": 156.33,
  "text": "공통점이었습니다."
 },
 {
  "in": 156.41,
  "out": 158.51,
  "text": "정부도 올해 AI를\n적극 도입한 기업을"
 },
 {
  "in": 158.59,
