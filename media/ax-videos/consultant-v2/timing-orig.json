  {
   "block": 3,
   "line": 2,
   "part": 0,
   "text": "솔직히 대부분 주먹구구식이고",
   "start": 60.32,
   "end": 62.5
  },
  {
   "block": 3,
   "line": 2,
   "part": 1,
   "text": "감과 기억에 의존하실 겁니다.",
   "start": 62.52,
