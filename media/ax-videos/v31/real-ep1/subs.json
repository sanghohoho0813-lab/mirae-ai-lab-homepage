[
 {
  "in": 0.6,
  "out": 2.55,
  "text": "AI를 도입하면 회사가"
 },
 {
  "in": 2.63,
  "out": 4.27,
  "text": "어떻게 **달라질까요?**"
 },
 {
  "in": 4.49,
  "out": 6.03,
  "text": "기록을 디지털로 옮기는 건"
 },
 {
  "in": 6.11,
  "out": 7.67,
  "text": "**시작**일 뿐입니다."
 },
 {
  "in": 7.75,
  "out": 10.09,
  "text": "저희는 그 데이터를 분석해서"
 },
 {
  "in": 10.21,
  "out": 11.45,
  "text": "지금 뭘 해야 하는지까지"
 },
 {
  "in": 11.53,
  "out": 13.33,
  "text": "알려주는 걸 만들고 있어요."
 },
 {
  "in": 13.65,
  "out": 15.11,
  "text": "지금 실제로 계속 개발하고 있는"
 },
 {
  "in": 15.19,
  "out": 16.37,
  "text": "여러 업체 중에서"
 },
 {
  "in": 16.45,
  "out": 18.17,
  "text": "두 곳이 어떻게 바뀌고 있는지만"
 },
 {
  "in": 18.25,
  "out": 19.81,
  "text": "보여드리겠습니다."
 },
 {
  "in": 19.89,
  "out": 22.07,
  "text": "첫 번째는 병원 **의료폐기물**을"
 },
 {
  "in": 22.15,
  "out": 24.17,
  "text": "수거하고 운반하는 회사입니다."
 },
 {
  "in": 24.25,
  "out": 26.15,
  "text": "병원마다 **수거 주기**가 다르고,"
 },
 {
  "in": 26.23,
  "out": 28.55,
  "text": "정산 기준도 월정액인 곳이 있고"
 },
 {
  "in": 28.63,
  "out": 30.11,
  "text": "무게당 단가인 곳이 있어서"
 },
 {
  "in": 30.19,
  "out": 31.61,
  "text": "꽤 **복잡**해요."
 },
 {
  "in": 31.69,
  "out": 32.95,
  "text": "예전에는 현장 직원이"
 },
 {
  "in": 33.03,
  "out": 34.61,
  "text": "여러 정보를 **수기**로 적고"
 },
 {
  "in": 34.69,
  "out": 36.47,
  "text": "사진을 찍어서 저녁에 정리해"
 },
 {
  "in": 36.55,
  "out": 38.61,
  "text": "사무실에 카톡으로 보냈습니다."
 },
 {
  "in": 38.69,
  "out": 40.19,
  "text": "그러면 사무실에서 다시 확인하고"
 },
 {
  "in": 40.27,
  "out": 41.97,
  "text": "엑셀에 **옮겨 적었고요.**"
 },
 {
  "in": 42.05,
  "out": 43.39,
  "text": "거래처가 50여 곳이고"
 },
 {
  "in": 43.47,
  "out": 45.71,
  "text": "한 달에 105톤쯤 수거하다 보니"
 },
 {
  "in": 45.79,
  "out": 48.55,
  "text": "수거부터 자재, 정산, 미수금까지"
 },
 {
  "in": 48.63,
  "out": 50.87,
  "text": "정보가 여러 곳에 **흩어져** 있었죠."
 },
 {
  "in": 50.95,
  "out": 52.11,
  "text": "현장과 본사 사이에서"
 },
 {
  "in": 52.19,
  "out": 54.53,
  "text": "낭비되는 **노력과 시간**이 많았어요."
 },
 {
  "in": 54.61,
  "out": 57.13,
  "text": "지금은 현장에서 휴대폰으로\n**한 번** 입력하면"
 },
 {
  "in": 57.21,
  "out": 59.83,
  "text": "수거 이력과 자재, 재고,"
 },
 {
  "in": 59.91,
  "out": 61.03,
  "text": "정산에 필요한 정보까지"
 },
 {
  "in": 61.11,
  "out": 63.31,
  "text": "**하나의 흐름**으로 이어집니다."
 },
 {
  "in": 63.39,
  "out": 64.81,
  "text": "병원도 **전용 포털**에서"
 },
 {
  "in": 64.89,
  "out": 66.35,
  "text": "추가 수거나 자재 용기를"
 },
 {
  "in": 66.43,
  "out": 68.59,
  "text": "미리 요청하는 곳이 늘고 있어요."
 },
 {
  "in": 68.93,
  "out": 70.13,
  "text": "그래서 당일에 갑자기 들어오는"
 },
 {
  "in": 70.21,
  "out": 71.65,
  "text": "긴급 수거나 자재 요청이"
 },
 {
  "in": 71.73,
  "out": 72.97,
  "text": "**줄어들고** 있습니다."
 },
 {
  "in": 73.21,
  "out": 75.17,
  "text": "정산은 병원별 계약 조건과"
 },
 {
  "in": 75.25,
  "out": 76.95,
  "text": "단가 이력을 기준으로 연결해서"
 },
 {
  "in": 77.03,
  "out": 78.69,
  "text": "청구와 입금, 미수금까지"
 },
 {
  "in": 78.77,
  "out": 79.91,
  "text": "**한 곳**에서 확인할 수 있게"
 },
 {
  "in": 79.99,
  "out": 81.09,
  "text": "만들고 있어요."
 },
 {
  "in": 81.17,
  "out": 83.21,
  "text": "그럼 **AI**는 여기서 뭘 할까요?"
 },
 {
  "in": 83.41,
  "out": 84.41,
  "text": "쌓인 수거량과"
 },
 {
  "in": 84.49,
  "out": 85.95,
  "text": "자재 사용 기록을 분석해서"
 },
 {
  "in": 86.03,
  "out": 87.91,
  "text": "어떤 병원에 어떤 물품이"
 },
 {
  "in": 87.99,
  "out": 89.21,
  "text": "다시 필요할 **시점**인지"
 },
 {
  "in": 89.29,
  "out": 90.61,
  "text": "먼저 보여드립니다."
 },
 {
  "in": 90.69,
  "out": 92.23,
  "text": "그리고 그게 실제 주문과"
 },
 {
  "in": 92.31,
  "out": 94.29,
  "text": "**추가 매출**로 이어지게 하고요."
 },
 {
  "in": 94.37,
  "out": 95.77,
  "text": "앞으로 병원별 수거 패턴과"
 },
 {
  "in": 95.85,
  "out": 97.67,
  "text": "갑작스러운 추가 요청,"
 },
 {
  "in": 97.75,
  "out": 99.93,
  "text": "차량과 기사 운영\n데이터까지 쌓이면"
 },
 {
  "in": 100.01,
  "out": 100.93,
  "text": "**동선과 배차**를"
 },
 {
  "in": 101.01,
  "out": 102.63,
  "text": "더 효율적으로 잡아서"
 },
 {
  "in": 102.71,
  "out": 104.11,
  "text": "같은 인원과 차량으로"
 },
 {
  "in": 104.19,
  "out": 106.03,
  "text": "더 많은 거래처를\n관리할 수 있도록"
 },
 {
  "in": 106.11,
  "out": 107.77,
  "text": "**고도화**할 계획입니다."
 },
 {
  "in": 107.91,
  "out": 109.43,
  "text": "결국 목표는 **분명**해요."
 },
 {
  "in": 109.51,
  "out": 110.73,
  "text": "반복되는 행정 업무와"
 },
 {
  "in": 110.81,
  "out": 112.41,
  "text": "불필요한 이동은 **줄이고**,"
 },
 {
  "in": 112.49,
  "out": 114.17,
  "text": "빠지는 정산은 **막고**,"
 },
 {
  "in": 114.25,
  "out": 116.45,
  "text": "같은 인력으로 더\n많은 일을 처리하면서"
 },
 {
  "in": 116.53,
  "out": 118.09,
  "text": "**새로운 매출**까지 만드는 겁니다."
 },
 {
  "in": 118.17,
  "out": 119.97,
  "text": "**다음 사업**도 같이 보고 있어요."
 },
 {
  "in": 120.05,
  "out": 121.25,
  "text": "병원에서 반복해서 쓰는"
 },
 {
  "in": 121.33,
  "out": 122.37,
  "text": "용기나 소모품을"
 },
 {
  "in": 122.45,
  "out": 123.75,
  "text": "필요한 **시점**에 추천하고,"
 },
 {
  "in": 123.83,
  "out": 126.49,
  "text": "주문을 받아 기존 수거\n일정과 함께 공급해서"
 },
 {
  "in": 126.57,
  "out": 128.43,
  "text": "새로운 매출을 만들 계획입니다."
 },
 {
  "in": 128.51,
  "out": 131.63,
  "text": "중장기적으로는 이 시스템의\n실제 운영 데이터와"
 },
 {
  "in": 131.71,
  "out": 133.25,
  "text": "노하우가 충분히 쌓이면"
 },
 {
  "in": 133.33,
  "out": 136.03,
  "text": "비슷한 일을 하는 다른\n의료폐기물 업체도 쓸 수 있는"
 },
 {
  "in": 136.11,
  "out": 138.59,
  "text": "**구독형 서비스**로 넓히는\n것까지 보고 있습니다."
 },
 {
  "in": 138.67,
  "out": 140.37,
  "text": "한 회사의 업무를 개선하는 데서"
 },
 {
  "in": 140.45,
  "out": 141.39,
  "text": "끝나지 않고,"
 },
 {
  "in": 141.47,
  "out": 143.79,
  "text": "현장에서 검증된 운영 방식 자체를"
 },
 {
  "in": 143.87,
  "out": 145.49,
  "text": "**새로운 사업**으로 키우는 겁니다."
 }
]