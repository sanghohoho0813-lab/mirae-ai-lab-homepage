[{"start": 0.35, "end": 3.18, "text": "컨설턴트님, 요즘 하루 어떻게 흘러가세요?", "words": [{"s": 0.45, "e": 1.225, "w": " 컨설턴트님,"}, {"s": 1.225, "e": 1.52, "w": " 요즘"}, {"s": 1.52, "e": 1.815, "w": " 하루"}, {"s": 1.815, "e": 2.258, "w": " 어떻게"}, {"s": 2.258, "e": 3.033, "w": " 흘러가세요?"}]}, {"start": 3.53, "end": 5.4, "text": "고객사 서류 찾다가 하루,", "words": [{"s": 3.633, "e": 4.107, "w": " 고객사"}, {"s": 4.107, "e": 4.422, "w": " 서류"}, {"s": 4.422, "e": 4.895, "w": " 찾다가"}, {"s": 4.895, "e": 5.25, "w": " 하루,"}]}, {"start": 5.55, "end": 8.18, "text": "“어디까지 됐어요?” 카톡에 답하다 하루.", "words": [{"s": 5.65, "e": 6.283, "w": " “어디까지"}, {"s": 6.283, "e": 6.804, "w": " 됐어요?”"}, {"s": 6.804, "e": 7.251, "w": " 카톡에"}, {"s": 7.251, "e": 7.698, "w": " 답하다"}, {"s": 7.698, "e": 8.033, "w": " 하루."}]}, {"start": 8.53, "end": 10.23, "text": "정작 다음 계약 준비는", "words": [{"s": 8.633, "e": 8.956, "w": " 정작"}, {"s": 8.956, "e": 9.278, "w": " 다음"}, {"s": 9.278, "e": 9.6, "w": " 계약"}, {"s": 9.6, "e": 10.083, "w": " 준비는"}]}, {"start": 10.38, "end": 11.88, "text": "늘 뒤로 밀리죠.", "words": [{"s": 10.483, "e": 10.683, "w": " 늘"}, {"s": 10.683, "e": 11.083, "w": " 뒤로"}, {"s": 11.083, "e": 11.733, "w": " 밀리죠."}]}, {"start": 14.08, "end": 16.18, "text": "고객사가 다섯 곳만 넘어가도", "words": [{"s": 14.183, "e": 14.8, "w": " 고객사가"}, {"s": 14.8, "e": 15.108, "w": " 다섯"}, {"s": 15.108, "e": 15.417, "w": " 곳만"}, {"s": 15.417, "e": 16.033, "w": " 넘어가도"}]}, {"start": 16.33, "end": 18.2, "text": "일은 이렇게 흩어집니다.", "words": [{"s": 16.433, "e": 16.749, "w": " 일은"}, {"s": 16.749, "e": 17.222, "w": " 이렇게"}, {"s": 17.222, "e": 18.05, "w": " 흩어집니다."}]}, {"start": 18.55, "end": 20.62, "text": "서류는 카톡, 메일, 사진첩에.", "words": [{"s": 18.65, "e": 19.114, "w": " 서류는"}, {"s": 19.114, "e": 19.462, "w": " 카톡,"}, {"s": 19.462, "e": 19.81, "w": " 메일,"}, {"s": 19.81, "e": 20.467, "w": " 사진첩에."}]}, {"start": 20.77, "end": 23.17, "text": "사업자등록번호는 엑셀 어딘가에.", "words": [{"s": 20.867, "e": 22.074, "w": " 사업자등록번호는"}, {"s": 22.074, "e": 22.375, "w": " 엑셀"}, {"s": 22.375, "e": 23.017, "w": " 어딘가에."}]}, {"start": 23.52, "end": 26.08, "text": "수금일, 신청 마감, 다음에 연락할 날은", "words": [{"s": 23.617, "e": 24.102, "w": " 수금일,"}, {"s": 24.102, "e": 24.401, "w": " 신청"}, {"s": 24.401, "e": 24.738, "w": " 마감,"}, {"s": 24.738, "e": 25.186, "w": " 다음에"}, {"s": 25.186, "e": 25.634, "w": " 연락할"}, {"s": 25.634, "e": 25.933, "w": " 날은"}]}, {"start": 26.23, "end": 27.83, "text": "머릿속에만 있고요.", "words": [{"s": 26.333, "e": 27.152, "w": " 머릿속에만"}, {"s": 27.152, "e": 27.683, "w": " 있고요."}]}, {"start": 28.38, "end": 30.25, "text": "더 큰 문제는 따로 있어요.", "words": [{"s": 28.483, "e": 28.641, "w": " 더"}, {"s": 28.641, "e": 28.799, "w": " 큰"}, {"s": 28.799, "e": 29.272, "w": " 문제는"}, {"s": 29.272, "e": 29.587, "w": " 따로"}, {"s": 29.587, "e": 30.1, "w": " 있어요."}]}, {"start": 30.6, "end": 32.7, "text": "같은 서류를 두 번 달라고 하면", "words": [{"s": 30.7, "e": 31.008, "w": " 같은"}, {"s": 31.008, "e": 31.471, "w": " 서류를"}, {"s": 31.471, "e": 31.625, "w": " 두"}, {"s": 31.625, "e": 31.779, "w": " 번"}, {"s": 31.779, "e": 32.242, "w": " 달라고"}, {"s": 32.242, "e": 32.55, "w": " 하면"}]}, {"start": 32.85, "end": 34.85, "text": "고객은 조용히 불안해지고,", "words": [{"s": 32.95, "e": 33.417, "w": " 고객은"}, {"s": 33.417, "e": 33.883, "w": " 조용히"}, {"s": 33.883, "e": 34.7, "w": " 불안해지고,"}]}, {"start": 35.2, "end": 36.7, "text": "마감 하나 놓치면", "words": [{"s": 35.3, "e": 35.657, "w": " 마감"}, {"s": 35.657, "e": 36.014, "w": " 하나"}, {"s": 36.014, "e": 36.55, "w": " 놓치면"}]}, {"start": 36.85, "end": 39.25, "text": "쌓아 온 신뢰가 한 번에 흔들립니다.", "words": [{"s": 36.95, "e": 37.252, "w": " 쌓아"}, {"s": 37.252, "e": 37.403, "w": " 온"}, {"s": 37.403, "e": 37.855, "w": " 신뢰가"}, {"s": 37.855, "e": 38.006, "w": " 한"}, {"s": 38.006, "e": 38.308, "w": " 번에"}, {"s": 38.308, "e": 39.1, "w": " 흔들립니다."}]}, {"start": 39.6, "end": 41.6, "text": "그러면 추가 계약도, 소개도", "words": [{"s": 39.7, "e": 40.167, "w": " 그러면"}, {"s": 40.167, "e": 40.478, "w": " 추가"}, {"s": 40.478, "e": 40.983, "w": " 계약도,"}, {"s": 40.983, "e": 41.45, "w": " 소개도"}]}, {"start": 41.75, "end": 43.25, "text": "조용히 멀어지죠.", "words": [{"s": 41.85, "e": 42.367, "w": " 조용히"}, {"s": 42.367, "e": 43.1, "w": " 멀어지죠."}]}, {"start": 44.75, "end": 46.72, "text": "결국 다음 계약을 부르는 건", "words": [{"s": 44.85, "e": 45.162, "w": " 결국"}, {"s": 45.162, "e": 45.474, "w": " 다음"}, {"s": 45.474, "e": 45.942, "w": " 계약을"}, {"s": 45.942, "e": 46.411, "w": " 부르는"}, {"s": 46.411, "e": 46.567, "w": " 건"}]}, {"start": 46.87, "end": 48.43, "text": "화려한 제안서보다", "words": [{"s": 46.967, "e": 47.46, "w": " 화려한"}, {"s": 47.46, "e": 48.283, "w": " 제안서보다"}]}, {"start": 48.78, "end": 50.95, "text": "“그 컨설턴트는 관리가 확실해”", "words": [{"s": 48.883, "e": 49.075, "w": " “그"}, {"s": 49.075, "e": 49.842, "w": " 컨설턴트는"}, {"s": 49.842, "e": 50.302, "w": " 관리가"}, {"s": 50.302, "e": 50.8, "w": " 확실해”"}]}, {"start": 51.1, "end": 52.6, "text": "이 한마디예요.", "words": [{"s": 51.2, "e": 51.4, "w": " 이"}, {"s": 51.4, "e": 52.45, "w": " 한마디예요."}]}, {"start": 54.1, "end": 55.83, "text": "그래서 만들었습니다.", "words": [{"s": 54.2, "e": 54.681, "w": " 그래서"}, {"s": 54.681, "e": 55.683, "w": " 만들었습니다."}]}, {"start": 55.98, "end": 58.38, "text": "컨설턴트 운영 OS, MIRAE AI LAB OS.", "words": [{"s": 56.083, "e": 56.687, "w": " 컨설턴트"}, {"s": 56.687, "e": 56.989, "w": " 운영"}, {"s": 56.989, "e": 57.193, "w": " OS,"}, {"s": 57.193, "e": 57.608, "w": " MIRAE"}, {"s": 57.608, "e": 57.774, "w": " AI"}, {"s": 57.774, "e": 58.023, "w": " LAB"}, {"s": 58.023, "e": 58.227, "w": " OS."}]}, {"start": 58.73, "end": 60.4, "text": "9년 현장의 일을 담아,", "words": [{"s": 58.827, "e": 59.077, "w": " 9년"}, {"s": 59.077, "e": 59.563, "w": " 현장의"}, {"s": 59.563, "e": 59.886, "w": " 일을"}, {"s": 59.886, "e": 60.25, "w": " 담아,"}]}, {"start": 60.55, "end": 62.82, "text": "매일 직접 쓰는 기능만 넣었어요.", "words": [{"s": 60.65, "e": 60.954, "w": " 매일"}, {"s": 60.954, "e": 61.259, "w": " 직접"}, {"s": 61.259, "e": 61.563, "w": " 쓰는"}, {"s": 61.563, "e": 62.02, "w": " 기능만"}, {"s": 62.02, "e": 62.667, "w": " 넣었어요."}]}, {"start": 63.17, "end": 64.67, "text": "아침에 열면", "words": [{"s": 63.267, "e": 64.017, "w": " 아침에"}, {"s": 64.017, "e": 64.517, "w": " 열면"}]}, {"start": 64.82, "end": 67.08, "text": "오늘 꼭 처리할 일이 정리돼 있고,", "words": [{"s": 64.917, "e": 65.221, "w": " 오늘"}, {"s": 65.221, "e": 65.373, "w": " 꼭"}, {"s": 65.373, "e": 65.83, "w": " 처리할"}, {"s": 65.83, "e": 66.134, "w": " 일이"}, {"s": 66.134, "e": 66.591, "w": " 정리돼"}, {"s": 66.591, "e": 66.933, "w": " 있고,"}]}, {"start": 67.43, "end": 68.93, "text": "먼저 할 세 가지를", "words": [{"s": 67.533, "e": 67.89, "w": " 먼저"}, {"s": 67.89, "e": 68.069, "w": " 할"}, {"s": 68.069, "e": 68.248, "w": " 세"}, {"s": 68.248, "e": 68.783, "w": " 가지를"}]}, {"start": 69.08, "end": 70.82, "text": "이유와 함께 알려 줘요.", "words": [{"s": 69.183, "e": 69.664, "w": " 이유와"}, {"s": 69.664, "e": 69.985, "w": " 함께"}, {"s": 69.985, "e": 70.306, "w": " 알려"}, {"s": 70.306, "e": 70.667, "w": " 줘요."}]}, {"start": 71.37, "end": 73.23, "text": "서류는 한 번만 받으면 끝.", "words": [{"s": 71.467, "e": 71.94, "w": " 서류는"}, {"s": 71.94, "e": 72.098, "w": " 한"}, {"s": 72.098, "e": 72.413, "w": " 번만"}, {"s": 72.413, "e": 72.886, "w": " 받으면"}, {"s": 72.886, "e": 73.083, "w": " 끝."}]}, {"start": 73.38, "end": 75.65, "text": "밖에서도 폰으로 바로 꺼내 봐요.", "words": [{"s": 73.483, "e": 74.092, "w": " 밖에서도"}, {"s": 74.092, "e": 74.549, "w": " 폰으로"}, {"s": 74.549, "e": 74.853, "w": " 바로"}, {"s": 74.853, "e": 75.158, "w": " 꺼내"}, {"s": 75.158, "e": 75.5, "w": " 봐요."}]}, {"start": 76.0, "end": 78.53, "text": "사업자등록번호부터 받은 서류까지,", "words": [{"s": 76.1, "e": 77.448, "w": " 사업자등록번호부터"}, {"s": 77.448, "e": 77.747, "w": " 받은"}, {"s": 77.747, "e": 78.383, "w": " 서류까지,"}]}, {"start": 78.68, "end": 80.55, "text": "고객사 정보가 한 화면에.", "words": [{"s": 78.783, "e": 79.257, "w": " 고객사"}, {"s": 79.257, "e": 79.73, "w": " 정보가"}, {"s": 79.73, "e": 79.887, "w": " 한"}, {"s": 79.887, "e": 80.4, "w": " 화면에."}]}, {"start": 80.9, "end": 83.47, "text": "받을 돈, 신청 마감, 다음에 연락할 날은", "words": [{"s": 81.0, "e": 81.299, "w": " 받을"}, {"s": 81.299, "e": 81.486, "w": " 돈,"}, {"s": 81.486, "e": 81.785, "w": " 신청"}, {"s": 81.785, "e": 82.121, "w": " 마감,"}, {"s": 82.121, "e": 82.569, "w": " 다음에"}, {"s": 82.569, "e": 83.018, "w": " 연락할"}, {"s": 83.018, "e": 83.317, "w": " 날은"}]}, {"start": 83.62, "end": 85.23, "text": "OS가 먼저 챙겨 줘요.", "words": [{"s": 83.717, "e": 84.06, "w": " OS가"}, {"s": 84.06, "e": 84.386, "w": " 먼저"}, {"s": 84.386, "e": 84.713, "w": " 챙겨"}, {"s": 84.713, "e": 85.08, "w": " 줘요."}]}, {"start": 85.78, "end": 88.28, "text": "고객이 서류를 올리고 요청을 남기면", "words": [{"s": 85.88, "e": 86.33, "w": " 고객이"}, {"s": 86.33, "e": 86.78, "w": " 서류를"}, {"s": 86.78, "e": 87.23, "w": " 올리고"}, {"s": 87.23, "e": 87.68, "w": " 요청을"}, {"s": 87.68, "e": 88.13, "w": " 남기면"}]}, {"start": 88.43, "end": 90.83, "text": "내 상담신청함으로 바로 들어오고,", "words": [{"s": 88.53, "e": 88.681, "w": " 내"}, {"s": 88.681, "e": 89.737, "w": " 상담신청함으로"}, {"s": 89.737, "e": 90.039, "w": " 바로"}, {"s": 90.039, "e": 90.68, "w": " 들어오고,"}]}, {"start": 91.18, "end": 93.41, "text": "정리된 결과만 고객에게 보이니", "words": [{"s": 91.28, "e": 91.738, "w": " 정리된"}, {"s": 91.738, "e": 92.195, "w": " 결과만"}, {"s": 92.195, "e": 92.806, "w": " 고객에게"}, {"s": 92.806, "e": 93.263, "w": " 보이니"}]}, {"start": 93.56, "end": 95.93, "text": "“어디까지 됐어요?” 카톡이 줄어요.", "words": [{"s": 93.663, "e": 94.306, "w": " “어디까지"}, {"s": 94.306, "e": 94.835, "w": " 됐어요?”"}, {"s": 94.835, "e": 95.289, "w": " 카톡이"}, {"s": 95.289, "e": 95.78, "w": " 줄어요."}]}, {"start": 96.48, "end": 98.75, "text": "그리고 여기서부터가 진짜예요.", "words": [{"s": 96.58, "e": 97.037, "w": " 그리고"}, {"s": 97.037, "e": 97.95, "w": " 여기서부터가"}, {"s": 97.95, "e": 98.597, "w": " 진짜예요."}]}, {"start": 99.1, "end": 100.6, "text": "올려 둔 서류가", "words": [{"s": 99.197, "e": 99.613, "w": " 올려"}, {"s": 99.613, "e": 99.822, "w": " 둔"}, {"s": 99.822, "e": 100.447, "w": " 서류가"}]}, {"start": 100.75, "end": 103.15, "text": "다음에 제안할 거리를 찾아 줍니다.", "words": [{"s": 100.847, "e": 101.299, "w": " 다음에"}, {"s": 101.299, "e": 101.752, "w": " 제안할"}, {"s": 101.752, "e": 102.205, "w": " 거리를"}, {"s": 102.205, "e": 102.506, "w": " 찾아"}, {"s": 102.506, "e": 102.997, "w": " 줍니다."}]}, {"start": 103.5, "end": 106.76, "text": "고용지원금, 기업부설연구소, 정책자금, 세금까지", "words": [{"s": 103.597, "e": 104.36, "w": " 고용지원금,"}, {"s": 104.36, "e": 105.414, "w": " 기업부설연구소,"}, {"s": 105.414, "e": 106.032, "w": " 정책자금,"}, {"s": 106.032, "e": 106.613, "w": " 세금까지"}]}, {"start": 106.91, "end": 108.78, "text": "다음 모듈로 이어지니까,", "words": [{"s": 107.013, "e": 107.329, "w": " 다음"}, {"s": 107.329, "e": 107.802, "w": " 모듈로"}, {"s": 107.802, "e": 108.63, "w": " 이어지니까,"}]}, {"start": 109.13, "end": 111.36, "text": "“대표님, 다음엔 이걸 해 보시죠.”", "words": [{"s": 109.23, "e": 109.764, "w": " “대표님,"}, {"s": 109.764, "e": 110.222, "w": " 다음엔"}, {"s": 110.222, "e": 110.527, "w": " 이걸"}, {"s": 110.527, "e": 110.679, "w": " 해"}, {"s": 110.679, "e": 111.213, "w": " 보시죠.”"}]}, {"start": 111.51, "end": 113.65, "text": "추가 계약이 자연스러워져요.", "words": [{"s": 111.613, "e": 111.921, "w": " 추가"}, {"s": 111.921, "e": 112.382, "w": " 계약이"}, {"s": 112.382, "e": 113.497, "w": " 자연스러워져요."}]}, {"start": 115.15, "end": 117.68, "text": "새 고객과의 첫 미팅부터 달라 보여요.", "words": [{"s": 115.247, "e": 115.396, "w": " 새"}, {"s": 115.396, "e": 115.995, "w": " 고객과의"}, {"s": 115.995, "e": 116.145, "w": " 첫"}, {"s": 116.145, "e": 116.744, "w": " 미팅부터"}, {"s": 116.744, "e": 117.043, "w": " 달라"}, {"s": 117.043, "e": 117.53, "w": " 보여요."}]}, {"start": 118.03, "end": 119.93, "text": "“서류는 여기 올려 주시고,", "words": [{"s": 118.13, "e": 118.641, "w": " “서류는"}, {"s": 118.641, "e": 118.955, "w": " 여기"}, {"s": 118.955, "e": 119.269, "w": " 올려"}, {"s": 119.269, "e": 119.78, "w": " 주시고,"}]}, {"start": 120.08, "end": 122.38, "text": "진행 상황은 여기서 보시면 돼요.”", "words": [{"s": 120.18, "e": 120.484, "w": " 진행"}, {"s": 120.484, "e": 120.939, "w": " 상황은"}, {"s": 120.939, "e": 121.395, "w": " 여기서"}, {"s": 121.395, "e": 121.85, "w": " 보시면"}, {"s": 121.85, "e": 122.23, "w": " 돼요.”"}]}, {"start": 122.73, "end": 124.86, "text": "크레탑 분석기, 세금 계산기로", "words": [{"s": 122.83, "e": 123.291, "w": " 크레탑"}, {"s": 123.291, "e": 123.791, "w": " 분석기,"}, {"s": 123.791, "e": 124.098, "w": " 세금"}, {"s": 124.098, "e": 124.713, "w": " 계산기로"}]}, {"start": 125.01, "end": 127.41, "text": "그 자리에서 숫자로 보여 드리고요.", "words": [{"s": 125.113, "e": 125.264, "w": " 그"}, {"s": 125.264, "e": 125.868, "w": " 자리에서"}, {"s": 125.868, "e": 126.32, "w": " 숫자로"}, {"s": 126.32, "e": 126.622, "w": " 보여"}, {"s": 126.622, "e": 127.263, "w": " 드리고요."}]}, {"start": 127.96, "end": 129.56, "text": "헛걸음은 사라지고,", "words": [{"s": 128.063, "e": 128.718, "w": " 헛걸음은"}, {"s": 128.718, "e": 129.413, "w": " 사라지고,"}]}, {"start": 129.71, "end": 132.25, "text": "같은 시간에 더 많은 고객사를 챙기고,", "words": [{"s": 129.813, "e": 130.113, "w": " 같은"}, {"s": 130.113, "e": 130.562, "w": " 시간에"}, {"s": 130.562, "e": 130.712, "w": " 더"}, {"s": 130.712, "e": 131.011, "w": " 많은"}, {"s": 131.011, "e": 131.61, "w": " 고객사를"}, {"s": 131.61, "e": 132.097, "w": " 챙기고,"}]}, {"start": 132.6, "end": 134.86, "text": "처음 맡는 분야도 금방 따라잡고,", "words": [{"s": 132.697, "e": 133.001, "w": " 처음"}, {"s": 133.001, "e": 133.305, "w": " 맡는"}, {"s": 133.305, "e": 133.762, "w": " 분야도"}, {"s": 133.762, "e": 134.066, "w": " 금방"}, {"s": 134.066, "e": 134.713, "w": " 따라잡고,"}]}, {"start": 135.21, "end": 136.71, "text": "관리가 확실하니", "words": [{"s": 135.313, "e": 135.849, "w": " 관리가"}, {"s": 135.849, "e": 136.563, "w": " 확실하니"}]}, {"start": 136.86, "end": 138.73, "text": "소개가 소개를 부르고요.", "words": [{"s": 136.963, "e": 137.437, "w": " 소개가"}, {"s": 137.437, "e": 137.91, "w": " 소개를"}, {"s": 137.91, "e": 138.58, "w": " 부르고요."}]}, {"start": 139.08, "end": 141.08, "text": "일이 일을 부르는 컨설턴트,", "words": [{"s": 139.18, "e": 139.491, "w": " 일이"}, {"s": 139.491, "e": 139.802, "w": " 일을"}, {"s": 139.802, "e": 140.269, "w": " 부르는"}, {"s": 140.269, "e": 140.93, "w": " 컨설턴트,"}]}, {"start": 141.23, "end": 143.23, "text": "이제 컨설턴트님 차례예요.", "words": [{"s": 141.33, "e": 141.641, "w": " 이제"}, {"s": 141.641, "e": 142.419, "w": " 컨설턴트님"}, {"s": 142.419, "e": 143.08, "w": " 차례예요."}]}, {"start": 144.73, "end": 146.23, "text": "2026년 10월부터", "words": [{"s": 144.83, "e": 145.378, "w": " 2026년"}, {"s": 145.378, "e": 146.08, "w": " 10월부터"}]}, {"start": 146.38, "end": 148.11, "text": "모듈을 하나씩 엽니다.", "words": [{"s": 146.48, "e": 146.961, "w": " 모듈을"}, {"s": 146.961, "e": 147.442, "w": " 하나씩"}, {"s": 147.442, "e": 147.963, "w": " 엽니다."}]}, {"start": 148.46, "end": 150.33, "text": "가장 먼저 써 보고 싶다면,", "words": [{"s": 148.563, "e": 148.879, "w": " 가장"}, {"s": 148.879, "e": 149.194, "w": " 먼저"}, {"s": 149.194, "e": 149.352, "w": " 써"}, {"s": 149.352, "e": 149.667, "w": " 보고"}, {"s": 149.667, "e": 150.18, "w": " 싶다면,"}]}, {"start": 150.48, "end": 152.61, "text": "지금 오픈 소식을 받아 두세요.", "words": [{"s": 150.58, "e": 150.887, "w": " 지금"}, {"s": 150.887, "e": 151.195, "w": " 오픈"}, {"s": 151.195, "e": 151.656, "w": " 소식을"}, {"s": 151.656, "e": 151.964, "w": " 받아"}, {"s": 151.964, "e": 152.463, "w": " 두세요."}]}]