[
 {
  "in": 0.6,
  "out": 2.43,
  "text": "AI를 도입하면 회사가"
 },
 {
  "in": 2.48,
  "out": 4.1,
  "text": "어떻게 **달라질까요?**"
 },
 {
  "in": 4.15,
  "out": 5.7,
  "text": "기록을 디지털로 옮기는 건"
 },
 {
  "in": 5.75,
  "out": 7.11,
  "text": "**시작**일 뿐입니다."
 },
 {
  "in": 7.16,
  "out": 8.99,
  "text": "저희는 그 데이터를 분석해서"
 },
 {
  "in": 9.04,
  "out": 10.89,
  "text": "지금 뭘 해야 하는지까지"
 },
 {
  "in": 10.94,
  "out": 12.64,
  "text": "알려주는 걸 만들고 있어요."
 },
 {
  "in": 12.69,
  "out": 14.25,
  "text": "지금 실제로 계속 개발하고 있는"
 },
 {
  "in": 14.3,
  "out": 15.51,
  "text": "여러 업체 중에서"
 },
 {
  "in": 15.56,
  "out": 17.23,
  "text": "두 곳이 어떻게 바뀌고 있는지만"
 },
 {
  "in": 17.28,
  "out": 18.59,
  "text": "보여드리겠습니다."
 },
 {
  "in": 19.33,
  "out": 21.51,
  "text": "첫 번째는 병원 **의료폐기물**을"
 },
 {
  "in": 21.56,
  "out": 23.23,
  "text": "수거하고 운반하는 회사입니다."
 },
 {
  "in": 23.28,
  "out": 25.5,
  "text": "병원마다 **수거 주기**가 다르고,"
 },
 {
  "in": 25.55,
  "out": 27.94,
  "text": "정산 기준도 월정액인 곳이 있고"
 },
 {
  "in": 27.99,
  "out": 29.52,
  "text": "무게당 단가인 곳이 있어서"
 },
 {
  "in": 29.57,
  "out": 30.77,
  "text": "꽤 **복잡**해요."
 },
 {
  "in": 31.23,
  "out": 32.56,
  "text": "예전에는 현장 직원이"
 },
 {
  "in": 32.61,
  "out": 34.25,
  "text": "여러 정보를 **수기**로 적고"
 },
 {
  "in": 34.3,
  "out": 35.95,
  "text": "사진을 찍어서 저녁에 정리해"
 },
 {
  "in": 36,
  "out": 37.78,
  "text": "사무실에 카톡으로 보냈습니다."
 },
 {
  "in": 37.9,
  "out": 39.54,
  "text": "그러면 사무실에서 다시 확인하고"
 },
 {
  "in": 39.59,
  "out": 40.92,
  "text": "엑셀에 **옮겨 적었고요.**"
 },
 {
  "in": 40.97,
  "out": 42.54,
  "text": "거래처가 50여 곳이고"
 },
 {
  "in": 42.59,
  "out": 44.71,
  "text": "한 달에 105톤쯤 수거하다 보니"
 },
 {
  "in": 44.76,
  "out": 47.66,
  "text": "수거부터 자재, 정산, 미수금까지"
 },
 {
  "in": 47.71,
  "out": 49.72,
  "text": "정보가 여러 곳에 **흩어져** 있었죠."
 },
 {
  "in": 49.77,
  "out": 51,
  "text": "현장과 본사 사이에서"
 },
 {
  "in": 51.05,
  "out": 53.7,
  "text": "낭비되는 **노력과 시간**이 많았어요."
 },
 {
  "in": 53.79,
  "out": 55.42,
  "text": "지금은 현장에서 휴대폰으로"
 },
 {
  "in": 55.47,
  "out": 56.41,
  "text": "**한 번** 입력하면"
 },
 {
  "in": 56.46,
  "out": 58.8,
  "text": "수거 이력과 자재, 재고,"
 },
 {
  "in": 58.85,
  "out": 60.28,
  "text": "정산에 필요한 정보까지"
 },
 {
  "in": 60.33,
  "out": 61.91,
  "text": "**하나의 흐름**으로 이어집니다."
 },
 {
  "in": 61.96,
  "out": 63.71,
  "text": "병원도 **전용 포털**에서"
 },
 {
  "in": 63.76,
  "out": 65.29,
  "text": "추가 수거나 자재 용기를"
 },
 {
  "in": 65.34,
  "out": 67.38,
  "text": "미리 요청하는 곳이 늘고 있어요."
 },
 {
  "in": 67.74,
  "out": 69.11,
  "text": "그래서 당일에 갑자기 들어오는"
 },
 {
  "in": 69.16,
  "out": 70.63,
  "text": "긴급 수거나 자재 요청이"
 },
 {
  "in": 70.68,
  "out": 71.92,
  "text": "**줄어들고** 있습니다."
 },
 {
  "in": 71.97,
  "out": 73.94,
  "text": "정산은 병원별 계약 조건과"
 },
 {
  "in": 73.99,
  "out": 75.81,
  "text": "단가 이력을 기준으로 연결해서"
 },
 {
  "in": 75.86,
  "out": 77.49,
  "text": "청구와 입금, 미수금까지"
 },
 {
  "in": 77.54,
  "out": 78.72,
  "text": "**한 곳**에서 확인할 수 있게"
 },
 {
  "in": 78.77,
  "out": 79.82,
  "text": "만들고 있어요."
 },
 {
  "in": 80.36,
  "out": 82.44,
  "text": "그럼 **AI**는 여기서 뭘 할까요?"
 },
 {
  "in": 82.68,
  "out": 83.77,
  "text": "쌓인 수거량과"
 },
 {
  "in": 83.82,
  "out": 85.38,
  "text": "자재 사용 기록을 분석해서"
 },
 {
  "in": 85.43,
  "out": 87.15,
  "text": "어떤 병원에 어떤 물품이"
 },
 {
  "in": 87.2,
  "out": 88.4,
  "text": "다시 필요할 **시점**인지"
 },
 {
  "in": 88.45,
  "out": 89.74,
  "text": "먼저 보여드립니다."
 },
 {
  "in": 89.79,
  "out": 91.28,
  "text": "그리고 그게 실제 주문과"
 },
 {
  "in": 91.33,
  "out": 93.12,
  "text": "**추가 매출**로 이어지게 하고요."
 },
 {
  "in": 93.17,
  "out": 94.88,
  "text": "앞으로 병원별 수거 패턴과"
 },
 {
  "in": 94.93,
  "out": 96.6,
  "text": "갑작스러운 추가 요청,"
 },
 {
  "in": 96.65,
  "out": 99,
  "text": "차량과 기사 운영\n데이터까지 쌓이면"
 },
 {
  "in": 99.05,
  "out": 100.1,
  "text": "**동선과 배차**를"
 },
 {
  "in": 100.15,
  "out": 101.72,
  "text": "더 효율적으로 잡아서"
 },
 {
  "in": 101.77,
  "out": 103.25,
  "text": "같은 인원과 차량으로"
 },
 {
  "in": 103.3,
  "out": 105.12,
  "text": "더 많은 거래처를\n관리할 수 있도록"
 },
 {
  "in": 105.17,
  "out": 106.81,
  "text": "**고도화**할 계획입니다."
 },
 {
  "in": 107.18,
  "out": 108.9,
  "text": "결국 목표는 **분명**해요."
 },
 {
  "in": 108.95,
  "out": 110.13,
  "text": "반복되는 행정 업무와"
 },
 {
  "in": 110.18,
  "out": 111.81,
  "text": "불필요한 이동은 **줄이고**,"
 },
 {
  "in": 111.86,
  "out": 113.43,
  "text": "빠지는 정산은 **막고**,"
 },
 {
  "in": 113.48,
  "out": 115.46,
  "text": "같은 인력으로 더\n많은 일을 처리하면서"
 },
 {
  "in": 115.51,
  "out": 117.66,
  "text": "**새로운 매출**까지 만드는 겁니다."
 },
 {
  "in": 118.17,
  "out": 119.69,
  "text": "**다음 사업**도 같이 보고 있어요."
 },
 {
  "in": 119.74,
  "out": 120.91,
  "text": "병원에서 반복해서 쓰는"
 },
 {
  "in": 120.96,
  "out": 122.03,
  "text": "용기나 소모품을"
 },
 {
  "in": 122.08,
  "out": 123.42,
  "text": "필요한 **시점**에 추천하고,"
 },
 {
  "in": 123.47,
  "out": 126.04,
  "text": "주문을 받아 기존 수거\n일정과 함께 공급해서"
 },
 {
  "in": 126.09,
  "out": 128.25,
  "text": "새로운 매출을 만들 계획입니다."
 },
 {
  "in": 128.53,
  "out": 131.15,
  "text": "중장기적으로는 이 시스템의\n실제 운영 데이터와"
 },
 {
  "in": 131.2,
  "out": 133.12,
  "text": "노하우가 충분히 쌓이면"
 },
 {
  "in": 133.17,
  "out": 135.69,
  "text": "비슷한 일을 하는 다른\n의료폐기물 업체도 쓸 수 있는"
 },
 {
  "in": 135.74,
  "out": 137.32,
  "text": "**구독형 서비스**로 넓히는 것까지"
 },
 {
  "in": 137.37,
  "out": 138.42,
  "text": "보고 있습니다."
 },
 {
  "in": 138.92,
  "out": 140.48,
  "text": "한 회사의 업무를 개선하는 데서"
 },
 {
  "in": 140.53,
  "out": 141.73,
  "text": "끝나지 않고,"
 },
 {
  "in": 141.78,
  "out": 143.99,
  "text": "현장에서 검증된 운영 방식 자체를"
 },
 {
  "in": 144.04,
  "out": 145.76,
  "text": "**새로운 사업**으로 키우는 겁니다."
 }
]