[
 {
  "in": 0.6,
  "out": 3.35,
  "text": "두 번째는 **쑥뜸원**입니다."
 },
 {
  "in": 3.43,
  "out": 4.77,
  "text": "쑥을 태워 몸을 따뜻하게"
 },
 {
  "in": 4.85,
  "out": 6.47,
  "text": "관리해 주는 곳인데,"
 },
 {
  "in": 6.55,
  "out": 8.13,
  "text": "마사지숍이나 피부관리실처럼"
 },
 {
  "in": 8.21,
  "out": 9.43,
  "text": "**이용권**을 끊고"
 },
 {
  "in": 9.51,
  "out": 10.71,
  "text": "정기적으로 다니는 매장이라고"
 },
 {
  "in": 10.79,
  "out": 12.17,
  "text": "생각하시면 쉬워요."
 },
 {
  "in": 12.27,
  "out": 14.77,
  "text": "고객 정보를 입력하고 기록하는 건"
 },
 {
  "in": 14.85,
  "out": 16.59,
  "text": "**어떤 프로그램이든** 할 수 있어요."
 },
 {
  "in": 16.89,
  "out": 19.89,
  "text": "여기서는 방문 기록과\n이용권, 상담 내용,"
 },
 {
  "in": 19.97,
  "out": 22.87,
  "text": "고객이 선호한 관리 부위와\n반응까지 **하나로** 연결합니다."
 },
 {
  "in": 22.95,
  "out": 24.79,
  "text": "휴대폰이나 태블릿에서"
 },
 {
  "in": 24.87,
  "out": 26.45,
  "text": "**몇 번만** 누르면 기록되고,"
 },
 {
  "in": 26.53,
  "out": 27.81,
  "text": "다음에 고객이 오시면"
 },
 {
  "in": 27.89,
  "out": 29.95,
  "text": "지난번에 어떤 관리를 받았고"
 },
 {
  "in": 30.03,
  "out": 32.33,
  "text": "무엇을 좋아하셨는지\n**바로** 보입니다."
 },
 {
  "in": 32.41,
  "out": 33.75,
  "text": "그럼 **기록 다음**엔"
 },
 {
  "in": 33.83,
  "out": 35.51,
  "text": "뭘 할 수 있을까요?"
 },
 {
  "in": 35.89,
  "out": 38.09,
  "text": "지금은 방문 주기와 이용권 상태,"
 },
 {
  "in": 38.17,
  "out": 39.85,
  "text": "상담 이후의 행동을 바탕으로"
 },
 {
  "in": 39.93,
  "out": 41.55,
  "text": "오늘 다시 챙겨야 할 고객의"
 },
 {
  "in": 41.63,
  "out": 43.23,
  "text": "**우선순위**를 먼저 보여줘요."
 },
 {
  "in": 43.31,
  "out": 45.17,
  "text": "이용권이 거의 끝난 고객,"
 },
 {
  "in": 45.25,
  "out": 46.43,
  "text": "다시 올 때가 된 고객,"
 },
 {
  "in": 46.51,
  "out": 49.53,
  "text": "상담은 했는데 아직 방문으로\n이어지지 않은 고객을"
 },
 {
  "in": 49.61,
  "out": 50.57,
  "text": "직원이 장부에서"
 },
 {
  "in": 50.65,
  "out": 52.17,
  "text": "**일일이** 찾지 않아도 됩니다."
 },
 {
  "in": 52.25,
  "out": 53.95,
  "text": "고객도 **전용 플랫폼**에서"
 },
 {
  "in": 54.03,
  "out": 56.17,
  "text": "이용 내역과 남은\n이용권을 확인하고,"
 },
 {
  "in": 56.25,
  "out": 57.45,
  "text": "방문을 요청하고,"
 },
 {
  "in": 57.53,
  "out": 58.97,
  "text": "새로운 상품이나 서비스도"
 },
 {
  "in": 59.05,
  "out": 60.49,
  "text": "다시 만나보실 수 있어요."
 },
 {
  "in": 60.57,
  "out": 63.03,
  "text": "앞으로 방문 데이터가\n충분히 쌓이면"
 },
 {
  "in": 63.11,
  "out": 64.69,
  "text": "**한 단계** 더 나아갑니다."
 },
 {
  "in": 64.77,
  "out": 67.13,
  "text": "어떤 고객이 **이탈**할\n가능성이 높은지,"
 },
 {
  "in": 67.21,
  "out": 69.95,
  "text": "어떤 프로그램이 **재방문**으로\n더 잘 이어지는지까지"
 },
 {
  "in": 70.03,
  "out": 71.33,
  "text": "AI가 분석해서"
 },
 {
  "in": 71.41,
  "out": 72.81,
  "text": "대표님이 먼저 챙겨야 할"
 },
 {
  "in": 72.89,
  "out": 73.97,
  "text": "고객과 **매출 기회**를"
 },
 {
  "in": 74.05,
  "out": 75.95,
  "text": "알려드리도록 고도화할 계획이에요."
 },
 {
  "in": 76.03,
  "out": 78.11,
  "text": "그러면 놓치던 고객은 **줄고**,"
 },
 {
  "in": 78.19,
  "out": 79.97,
  "text": "재방문과 이용권 재등록,"
 },
 {
  "in": 80.05,
  "out": 81.49,
  "text": "추가 구매는 **늘어나는** 게"
 },
 {
  "in": 81.57,
  "out": 83.09,
  "text": "성과로 이어집니다."
 },
 {
  "in": 83.17,
  "out": 84.27,
  "text": "여기도 **다음 사업**까지"
 },
 {
  "in": 84.35,
  "out": 85.93,
  "text": "같이 설계하고 있어요."
 },
 {
  "in": 86.01,
  "out": 87.53,
  "text": "지금의 고객 전용 플랫폼으로"
 },
 {
  "in": 87.61,
  "out": 89.61,
  "text": "쑥 화장품이나 생활 상품처럼"
 },
 {
  "in": 89.69,
  "out": 90.61,
  "text": "매장 밖에서도"
 },
 {
  "in": 90.69,
  "out": 91.93,
  "text": "**다시 살 수 있는** 상품까지"
 },
 {
  "in": 92.01,
  "out": 93.21,
  "text": "연결할 계획입니다."
 },
 {
  "in": 93.29,
  "out": 95.25,
  "text": "2호점이나 가맹점이 생겨도"
 },
 {
  "in": 95.33,
  "out": 96.63,
  "text": "본점의 운영 노하우를"
 },
 {
  "in": 96.71,
  "out": 98.77,
  "text": "데이터와 시스템으로 **표준화**해서"
 },
 {
  "in": 98.85,
  "out": 99.75,
  "text": "그대로 적용할 수 있게"
 },
 {
  "in": 99.83,
  "out": 101.17,
  "text": "만들어 가고 있고요."
 },
 {
  "in": 101.25,
  "out": 102.81,
  "text": "매장 하나를 편하게 운영하는"
 },
 {
  "in": 102.89,
  "out": 103.91,
  "text": "프로그램이 **아니라**,"
 },
 {
  "in": 103.99,
  "out": 105.99,
  "text": "고객과 계속 이어지면서"
 },
 {
  "in": 106.07,
  "out": 107.41,
  "text": "사업 자체가 **커질 수 있는**"
 },
 {
  "in": 107.49,
  "out": 108.47,
  "text": "기반을 만드는 겁니다."
 },
 {
  "in": 108.55,
  "out": 110.77,
  "text": "꼭 쑥뜸원이 아니어도"
 },
 {
  "in": 110.85,
  "out": 112.91,
  "text": "피부관리실이나 마사지숍,"
 },
 {
  "in": 112.99,
  "out": 113.91,
  "text": "필라테스처럼"
 },
 {
  "in": 113.99,
  "out": 116.75,
  "text": "이용권을 끊고 다시\n오시는 매장이라면"
 },
 {
  "in": 116.83,
  "out": 118.85,
  "text": "**똑같이** 적용할 수 있습니다."
 },
 {
  "in": 118.93,
  "out": 120.41,
  "text": "업종은 전혀 다르지만"
 },
 {
  "in": 120.49,
  "out": 121.99,
  "text": "**원리는 같습니다.**"
 },
 {
  "in": 122.09,
  "out": 123.31,
  "text": "한 번 입력한 데이터가"
 },
 {
  "in": 123.39,
  "out": 124.81,
  "text": "다음 업무로 **이어지고**,"
 },
 {
  "in": 124.89,
  "out": 126.39,
  "text": "쌓인 데이터를 분석해서"
 },
 {
  "in": 126.47,
  "out": 127.91,
  "text": "다음에 할 일을 **알려 주고**,"
 },
 {
  "in": 127.99,
  "out": 130.13,
  "text": "필요한 부분은 **자동으로** 처리해요."
 },
 {
  "in": 130.43,
  "out": 131.45,
  "text": "그래서 한 회사는"
 },
 {
  "in": 131.53,
  "out": 133.19,
  "text": "시간과 비용을 줄이면서"
 },
 {
  "in": 133.27,
  "out": 135.61,
  "text": "처리 능력과 새로운\n매출을 키우고,"
 },
 {
  "in": 135.69,
  "out": 137.65,
  "text": "다른 회사는 이탈을 줄이면서"
 },
 {
  "in": 137.73,
  "out": 140.61,
  "text": "재방문과 재구매를\n늘리고 있습니다."
 },
 {
  "in": 140.75,
  "out": 143.01,
  "text": "그럼 대표님한테는\n뭐가 **달라질까요?**"
 },
 {
  "in": 143.09,
  "out": 144.91,
  "text": "데이터를 직접 뒤지실 필요 없이"
 },
 {
  "in": 144.99,
  "out": 147.11,
  "text": "정리된 **우선순위와 근거**만 보고"
 },
 {
  "in": 147.19,
  "out": 148.73,
  "text": "결정하시면 됩니다."
 },
 {
  "in": 148.89,
  "out": 151.05,
  "text": "대표님 회사도 이렇게\n**바뀔 수 있어요.**"
 },
 {
  "in": 151.13,
  "out": 152.27,
  "text": "**미래AI랩**은"
 },
 {
  "in": 152.35,
  "out": 154.25,
  "text": "AI를 넣는 데서 끝내지 않고,"
 },
 {
  "in": 154.33,
  "out": 156.45,
  "text": "회사가 실제로 더 잘 돌아가고"
 },
 {
  "in": 156.53,
  "out": 158.29,
  "text": "성장하도록 만들어 드립니다."
 }
]