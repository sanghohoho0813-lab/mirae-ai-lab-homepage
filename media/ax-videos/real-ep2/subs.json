[
 {
  "in": 0.6,
  "out": 3.41,
  "text": "두 번째는 **쑥뜸원**입니다."
 },
 {
  "in": 3.46,
  "out": 5.16,
  "text": "쑥을 태워 몸을 따뜻하게"
 },
 {
  "in": 5.21,
  "out": 6.21,
  "text": "관리해 주는 곳인데,"
 },
 {
  "in": 6.26,
  "out": 8.43,
  "text": "마사지숍이나 피부관리실처럼"
 },
 {
  "in": 8.48,
  "out": 9.74,
  "text": "**이용권**을 끊고"
 },
 {
  "in": 9.79,
  "out": 11.07,
  "text": "정기적으로 다니는 매장이라고"
 },
 {
  "in": 11.12,
  "out": 12.44,
  "text": "생각하시면 쉬워요."
 },
 {
  "in": 12.64,
  "out": 15.13,
  "text": "고객 정보를 입력하고 기록하는 건"
 },
 {
  "in": 15.18,
  "out": 16.99,
  "text": "**어떤 프로그램이든** 할 수 있어요."
 },
 {
  "in": 17.3,
  "out": 20.38,
  "text": "여기서는 방문 기록과\n이용권, 상담 내용,"
 },
 {
  "in": 20.43,
  "out": 22.39,
  "text": "고객이 선호한 관리\n부위와 반응까지"
 },
 {
  "in": 22.44,
  "out": 23.52,
  "text": "**하나로** 연결합니다."
 },
 {
  "in": 23.57,
  "out": 25.56,
  "text": "휴대폰이나 태블릿에서"
 },
 {
  "in": 25.61,
  "out": 27.55,
  "text": "**몇 번만** 누르면 기록되고,"
 },
 {
  "in": 27.6,
  "out": 28.81,
  "text": "다음에 고객이 오시면"
 },
 {
  "in": 28.86,
  "out": 31.11,
  "text": "지난번에 어떤 관리를 받았고"
 },
 {
  "in": 31.16,
  "out": 33.09,
  "text": "무엇을 좋아하셨는지\n**바로** 보입니다."
 },
 {
  "in": 33.68,
  "out": 35.04,
  "text": "그럼 **기록 다음**엔"
 },
 {
  "in": 35.09,
  "out": 36.57,
  "text": "뭘 할 수 있을까요?"
 },
 {
  "in": 37.09,
  "out": 39.88,
  "text": "지금은 방문 주기와 이용권 상태,"
 },
 {
  "in": 39.93,
  "out": 41.72,
  "text": "상담 이후의 행동을 바탕으로"
 },
 {
  "in": 41.77,
  "out": 43.38,
  "text": "오늘 다시 챙겨야 할 고객의"
 },
 {
  "in": 43.43,
  "out": 44.61,
  "text": "**우선순위**를 먼저 보여줘요."
 },
 {
  "in": 44.66,
  "out": 46.84,
  "text": "이용권이 거의 끝난 고객,"
 },
 {
  "in": 46.89,
  "out": 48.34,
  "text": "다시 올 때가 된 고객,"
 },
 {
  "in": 48.39,
  "out": 51.48,
  "text": "상담은 했는데 아직 방문으로\n이어지지 않은 고객을"
 },
 {
  "in": 51.53,
  "out": 52.54,
  "text": "직원이 장부에서"
 },
 {
  "in": 52.59,
  "out": 54.6,
  "text": "**일일이** 찾지 않아도 됩니다."
 },
 {
  "in": 54.65,
  "out": 56.13,
  "text": "고객도 **전용 플랫폼**에서"
 },
 {
  "in": 56.18,
  "out": 58.4,
  "text": "이용 내역과 남은\n이용권을 확인하고,"
 },
 {
  "in": 58.45,
  "out": 59.61,
  "text": "방문을 요청하고,"
 },
 {
  "in": 59.66,
  "out": 61.21,
  "text": "새로운 상품이나 서비스도"
 },
 {
  "in": 61.26,
  "out": 62.68,
  "text": "다시 만나보실 수 있어요."
 },
 {
  "in": 62.73,
  "out": 65.78,
  "text": "앞으로 방문 데이터가\n충분히 쌓이면"
 },
 {
  "in": 65.83,
  "out": 67.39,
  "text": "**한 단계** 더 나아갑니다."
 },
 {
  "in": 67.64,
  "out": 70.04,
  "text": "어떤 고객이 **이탈**할\n가능성이 높은지,"
 },
 {
  "in": 70.09,
  "out": 72.73,
  "text": "어떤 프로그램이 **재방문**으로\n더 잘 이어지는지까지"
 },
 {
  "in": 72.78,
  "out": 74.02,
  "text": "AI가 분석해서"
 },
 {
  "in": 74.07,
  "out": 75.54,
  "text": "대표님이 먼저 챙겨야 할"
 },
 {
  "in": 75.59,
  "out": 76.69,
  "text": "고객과 **매출 기회**를"
 },
 {
  "in": 76.74,
  "out": 78.78,
  "text": "알려드리도록 고도화할 계획이에요."
 },
 {
  "in": 79.06,
  "out": 80.94,
  "text": "그러면 놓치던 고객은 **줄고**,"
 },
 {
  "in": 80.99,
  "out": 82.96,
  "text": "재방문과 이용권 재등록,"
 },
 {
  "in": 83.01,
  "out": 84.32,
  "text": "추가 구매는 **늘어나는** 게"
 },
 {
  "in": 84.37,
  "out": 85.66,
  "text": "성과로 이어집니다."
 },
 {
  "in": 86.09,
  "out": 87.62,
  "text": "여기도 **다음 사업**까지"
 },
 {
  "in": 87.67,
  "out": 89.4,
  "text": "같이 설계하고 있어요."
 },
 {
  "in": 89.45,
  "out": 91.1,
  "text": "지금의 고객 전용 플랫폼으로"
 },
 {
  "in": 91.15,
  "out": 93.21,
  "text": "쑥 화장품이나 생활 상품처럼"
 },
 {
  "in": 93.26,
  "out": 94.21,
  "text": "매장 밖에서도"
 },
 {
  "in": 94.26,
  "out": 95.54,
  "text": "**다시 살 수 있는** 상품까지"
 },
 {
  "in": 95.59,
  "out": 96.72,
  "text": "연결할 계획입니다."
 },
 {
  "in": 96.77,
  "out": 99,
  "text": "2호점이나 가맹점이 생겨도"
 },
 {
  "in": 99.05,
  "out": 100.39,
  "text": "본점의 운영 노하우를"
 },
 {
  "in": 100.44,
  "out": 102.47,
  "text": "데이터와 시스템으로 **표준화**해서"
 },
 {
  "in": 102.52,
  "out": 103.47,
  "text": "그대로 적용할 수 있게"
 },
 {
  "in": 103.52,
  "out": 104.81,
  "text": "만들어 가고 있고요."
 },
 {
  "in": 104.86,
  "out": 106.74,
  "text": "매장 하나를 편하게 운영하는"
 },
 {
  "in": 106.79,
  "out": 108.02,
  "text": "프로그램이 **아니라**,"
 },
 {
  "in": 108.07,
  "out": 110.14,
  "text": "고객과 계속 이어지면서"
 },
 {
  "in": 110.19,
  "out": 111.55,
  "text": "사업 자체가 **커질 수 있는**"
 },
 {
  "in": 111.6,
  "out": 113.31,
  "text": "기반을 만드는 겁니다."
 },
 {
  "in": 113.96,
  "out": 115.45,
  "text": "꼭 쑥뜸원이 아니어도"
 },
 {
  "in": 115.5,
  "out": 117.58,
  "text": "피부관리실이나 마사지숍,"
 },
 {
  "in": 117.63,
  "out": 118.63,
  "text": "필라테스처럼"
 },
 {
  "in": 118.68,
  "out": 121.5,
  "text": "이용권을 끊고 다시\n오시는 매장이라면"
 },
 {
  "in": 121.55,
  "out": 123.39,
  "text": "**똑같이** 적용할 수 있습니다."
 },
 {
  "in": 124.45,
  "out": 125.96,
  "text": "업종은 전혀 다르지만"
 },
 {
  "in": 126.01,
  "out": 127.28,
  "text": "**원리는 같습니다.**"
 },
 {
  "in": 127.33,
  "out": 128.98,
  "text": "한 번 입력한 데이터가"
 },
 {
  "in": 129.03,
  "out": 130.54,
  "text": "다음 업무로 **이어지고**,"
 },
 {
  "in": 130.59,
  "out": 132.16,
  "text": "쌓인 데이터를 분석해서"
 },
 {
  "in": 132.21,
  "out": 133.7,
  "text": "다음에 할 일을 **알려 주고**,"
 },
 {
  "in": 133.75,
  "out": 135.97,
  "text": "필요한 부분은 **자동으로** 처리해요."
 },
 {
  "in": 136.2,
  "out": 137.27,
  "text": "그래서 한 회사는"
 },
 {
  "in": 137.32,
  "out": 138.99,
  "text": "시간과 비용을 줄이면서"
 },
 {
  "in": 139.04,
  "out": 141.43,
  "text": "처리 능력과 새로운\n매출을 키우고,"
 },
 {
  "in": 141.48,
  "out": 143.56,
  "text": "다른 회사는 이탈을 줄이면서"
 },
 {
  "in": 143.61,
  "out": 146.26,
  "text": "재방문과 재구매를\n늘리고 있습니다."
 },
 {
  "in": 147.3,
  "out": 149.35,
  "text": "그럼 대표님한테는\n뭐가 **달라질까요?**"
 },
 {
  "in": 149.4,
  "out": 151.79,
  "text": "데이터를 직접 뒤지실 필요 없이"
 },
 {
  "in": 151.84,
  "out": 153.84,
  "text": "정리된 **우선순위와 근거**만 보고"
 },
 {
  "in": 153.89,
  "out": 155.51,
  "text": "결정하시면 됩니다."
 },
 {
  "in": 156.01,
  "out": 158.17,
  "text": "대표님 회사도 이렇게\n**바뀔 수 있어요.**"
 },
 {
  "in": 158.32,
  "out": 159.49,
  "text": "**미래AI랩**은"
 },
 {
  "in": 159.54,
  "out": 161.57,
  "text": "AI를 넣는 데서 끝내지 않고,"
 },
 {
  "in": 161.62,
  "out": 163.81,
  "text": "회사가 실제로 더 잘 돌아가고"
 },
 {
  "in": 163.86,
  "out": 165.63,
  "text": "성장하도록 만들어 드립니다."
 }
]