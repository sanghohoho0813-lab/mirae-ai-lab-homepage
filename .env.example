# ───────────────────────────────────────────────────────────────
# 문의 폼(api/inquiry.ts) 이메일 전송 설정 — Resend 사용
# 값을 채운 뒤 .env 로 복사하거나, 배포 플랫폼(Vercel) 환경변수에 등록하세요.
# 환경변수 등록 후에는 반드시 재배포(Redeploy) 해야 적용됩니다.
# ───────────────────────────────────────────────────────────────

# (필수) Resend API 키 — https://resend.com → API Keys 에서 발급
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# (선택) 문의 메일을 받을 주소 (기본값: sanghohoho0813@gmail.com)
INQUIRY_TO_EMAIL=sanghohoho0813@gmail.com

# (선택) 보내는 사람.
# 커스텀 도메인 인증 전에는 Resend 기본 발신주소(onboarding@resend.dev)를 사용하세요.
# 도메인 인증 후에는 이 값만 본인 도메인 주소로 바꾸면 됩니다.
INQUIRY_FROM_EMAIL="AI Business Lab <onboarding@resend.dev>"
