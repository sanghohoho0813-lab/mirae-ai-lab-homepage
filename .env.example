# 문의 폼(api/contact.ts) 이메일 전송 설정 — Resend 사용
# 값을 채운 뒤 .env 로 복사하거나, 배포 플랫폼(Vercel) 환경변수에 등록하세요.
# ───────────────────────────────────────────────────────────────

# Resend API 키 (https://resend.com → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# 문의 메일을 받을 주소
CONTACT_TO_EMAIL=sanghohoho0813@gmail.com

# 보내는 사람. Resend에서 인증된 도메인 사용을 권장합니다.
# 미설정 시 Resend 테스트 발신주소(onboarding@resend.dev)가 사용됩니다.
CONTACT_FROM_EMAIL="AI Business Lab <onboarding@resend.dev>"
