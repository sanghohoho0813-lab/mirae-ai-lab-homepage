# ───────────────────────────────────────────────────────────────
# Supabase (회원/권한 시스템) — 미래 AI 랩 중앙 포털
# 프로젝트 → Settings → API 에서 값을 복사하세요.
# ───────────────────────────────────────────────────────────────

# (프론트 공개 가능) Supabase 프로젝트 URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# (프론트 공개 가능) anon public 키
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠️ (서버 전용 / 절대 프론트에 노출 금지) service_role 키
#    관리자/체험 서버리스 함수(api/*)에서만 사용됩니다.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# (선택 / 프론트 공개 가능) 카카오 OAuth scope — 공백으로 구분.
#   기본값 'profile_nickname'. ⚠️ account_email 은 요청하지 않습니다(콘솔 미허용 시 KOE205 발생).
#   카카오 콘솔 동의항목이 다르면 여기서 조정하세요(예: 나중에 이메일 권한을 받으면 'profile_nickname account_email').
#   Supabase Kakao Provider 에서 "Allow users without an email" 을 ON 으로 두면 이메일 없는 사용자도 가입됩니다.
VITE_KAKAO_OAUTH_SCOPES=profile_nickname

# ───────────────────────────────────────────────────────────────
# 문의 폼(api/inquiry.ts) 이메일 전송 — Resend
# ───────────────────────────────────────────────────────────────

# (필수) Resend API 키 — https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# (선택) 문의 메일 수신 주소 (기본값 sanghohoho0813@gmail.com)
INQUIRY_TO_EMAIL=sanghohoho0813@gmail.com

# (선택) 보내는 사람 (도메인 인증 전에는 onboarding@resend.dev 그대로 사용)
INQUIRY_FROM_EMAIL="AI Business Lab <onboarding@resend.dev>"

# ───────────────────────────────────────────────────────────────
# 서비스몰 카드결제 — PortOne(포트원) V2 (설정 순서: docs/PORTONE_SETUP.md)
# 등록 후 Vercel Redeploy 해야 적용됩니다.
# ───────────────────────────────────────────────────────────────

# (프론트 공개 가능) 상점 아이디 (store-...)
VITE_PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# (프론트 공개 가능) 채널 키 — 카드결제 채널 (channel-key-...)
VITE_PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# (프론트 공개 가능) 배포 도메인 — 모바일 결제 복귀(redirect) 주소
VITE_PUBLIC_APP_URL=https://example.com

# (서버 전용) 상점 아이디 — 결제 검증 시 storeId 대조용 (위 VITE_ 값과 동일하게)
PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ⚠️ (서버 전용 / 절대 VITE_ 금지) V2 API Secret — 결제 상태·금액 재검증용
PORTONE_API_SECRET=portone_api_secret_xxxxxxxxxxxx

# ⚠️ (서버 전용 / 절대 VITE_ 금지) 웹훅 Secret (whsec_...) — 웹훅 서명 검증용
PORTONE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# (선택) test | live — test 면 화면에 '테스트 결제' 배지 표시 (기본 test)
PORTONE_ENV=test

# (선택) 웹훅 버전 표기 (기본 2024-04-25)
PORTONE_WEBHOOK_VERSION=2024-04-25

# (선택 / 서버 전용) 테스트 결제 외부노출 방지 접근코드
#  - PORTONE_ENV=test 이고 이 값이 설정되면: /checkout/...?testAccess=<코드> 로 들어온
#    방문자(또는 관리자 로그인)만 결제 가능. 일반 방문자는 상담 안내로 전환됩니다.
#  - 운영 테스트가 끝나면 이 변수를 제거하거나 값을 변경하세요. live 에서는 무시됩니다.
PAYMENT_TEST_ACCESS_CODE=

# ───────────────────────────────────────────────────────────────
# 휴대폰 본인인증 — PortOne V2 Identity Verification (설정 순서: docs/AUTH_IDENTITY_SETUP.md)
# ⚠️ 본인인증은 전자결제(PG)와 별도 서비스입니다. PortOne 콘솔에서 본인인증 채널을
#    따로 만들어야 하며, 결제 채널키(VITE_PORTONE_CHANNEL_KEY)를 여기에 재사용하지 마세요.
# Store ID / API Secret 은 결제와 같은 값을 재사용합니다 (위에서 이미 설정).
# ───────────────────────────────────────────────────────────────

# (프론트 공개 가능) 본인인증 전용 채널 키 — PortOne 콘솔 > 연동 정보 > 본인인증 채널
#   미설정 상태에서는 신규 회원가입이 안전하게 차단됩니다(가짜 인증 성공 없음).
VITE_PORTONE_IDENTITY_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# (선택) test | live — 본인인증 채널 환경 (기본 test)
PORTONE_IDENTITY_ENV=test

# (선택) 신규 가입 시 본인인증 필수 여부 — 기본 true. 'false' 는 개발 환경 전용.
IDENTITY_VERIFICATION_REQUIRED=true

# ⚠️ (선택 / 서버 전용) CI(연계정보) 단방향 해시 솔트 — 중복가입 방지용 해시에만 사용
IDENTITY_HASH_SALT=
